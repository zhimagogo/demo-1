shader_parameter/water_deep = Color(0.10, 0.39, 0.43, 1)
shader_parameter/water_shallow = Color(0.40, 0.66, 0.59, 1)
shader_parameter/flow_speed = 0.45
shader_parameter/ws_region_cut = 1.0

